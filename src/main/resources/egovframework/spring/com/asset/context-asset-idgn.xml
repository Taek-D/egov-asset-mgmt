<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- 비품·자산 업무 키 생성기 (COMTECOPSEQ). 형식: 접두사 + 0 채움, 전체 20자 -->

    <!-- 품목코드 ITEM_000000000000101 -->
    <bean name="assetItemIdGnrService" class="org.egovframe.rte.fdl.idgnr.impl.EgovTableIdGnrServiceImpl" destroy-method="destroy">
        <property name="dataSource" ref="egov.dataSource" />
        <property name="strategy"   ref="assetItemIdStrategy" />
        <property name="blockSize"  value="10"/>
        <property name="table"      value="COMTECOPSEQ"/>
        <property name="tableName"  value="ASSET_ITEM_ID"/>
    </bean>
    <bean name="assetItemIdStrategy" class="org.egovframe.rte.fdl.idgnr.impl.strategy.EgovIdGnrStrategyImpl">
        <property name="prefix"   value="ITEM_" />
        <property name="cipers"   value="15" />
        <property name="fillChar" value="0" />
    </bean>

    <!-- 재고 변동 이력 STKH_... -->
    <bean name="assetStockHistIdGnrService" class="org.egovframe.rte.fdl.idgnr.impl.EgovTableIdGnrServiceImpl" destroy-method="destroy">
        <property name="dataSource" ref="egov.dataSource" />
        <property name="strategy"   ref="assetStockHistIdStrategy" />
        <property name="blockSize"  value="10"/>
        <property name="table"      value="COMTECOPSEQ"/>
        <property name="tableName"  value="ASSET_STOCK_HIST_ID"/>
    </bean>
    <bean name="assetStockHistIdStrategy" class="org.egovframe.rte.fdl.idgnr.impl.strategy.EgovIdGnrStrategyImpl">
        <property name="prefix"   value="STKH_" />
        <property name="cipers"   value="15" />
        <property name="fillChar" value="0" />
    </bean>

    <!-- 개별 자산 이력 UNTH_... -->
    <bean name="assetUnitHistIdGnrService" class="org.egovframe.rte.fdl.idgnr.impl.EgovTableIdGnrServiceImpl" destroy-method="destroy">
        <property name="dataSource" ref="egov.dataSource" />
        <property name="strategy"   ref="assetUnitHistIdStrategy" />
        <property name="blockSize"  value="10"/>
        <property name="table"      value="COMTECOPSEQ"/>
        <property name="tableName"  value="ASSET_UNIT_HIST_ID"/>
    </bean>
    <bean name="assetUnitHistIdStrategy" class="org.egovframe.rte.fdl.idgnr.impl.strategy.EgovIdGnrStrategyImpl">
        <property name="prefix"   value="UNTH_" />
        <property name="cipers"   value="15" />
        <property name="fillChar" value="0" />
    </bean>

    <!-- 신청번호 REQ_0000000000000101 -->
    <bean name="assetReqIdGnrService" class="org.egovframe.rte.fdl.idgnr.impl.EgovTableIdGnrServiceImpl" destroy-method="destroy">
        <property name="dataSource" ref="egov.dataSource" />
        <property name="strategy"   ref="assetReqIdStrategy" />
        <property name="blockSize"  value="10"/>
        <property name="table"      value="COMTECOPSEQ"/>
        <property name="tableName"  value="ASSET_REQ_ID"/>
    </bean>
    <bean name="assetReqIdStrategy" class="org.egovframe.rte.fdl.idgnr.impl.strategy.EgovIdGnrStrategyImpl">
        <property name="prefix"   value="REQ_" />
        <property name="cipers"   value="16" />
        <property name="fillChar" value="0" />
    </bean>

    <!-- 신청 처리 이력 REQH_... -->
    <bean name="assetReqHistIdGnrService" class="org.egovframe.rte.fdl.idgnr.impl.EgovTableIdGnrServiceImpl" destroy-method="destroy">
        <property name="dataSource" ref="egov.dataSource" />
        <property name="strategy"   ref="assetReqHistIdStrategy" />
        <property name="blockSize"  value="10"/>
        <property name="table"      value="COMTECOPSEQ"/>
        <property name="tableName"  value="ASSET_REQ_HIST_ID"/>
    </bean>
    <bean name="assetReqHistIdStrategy" class="org.egovframe.rte.fdl.idgnr.impl.strategy.EgovIdGnrStrategyImpl">
        <property name="prefix"   value="REQH_" />
        <property name="cipers"   value="15" />
        <property name="fillChar" value="0" />
    </bean>

    <!-- 재고 부족 집계 실행 SHRT_... -->
    <bean name="assetShortageRunIdGnrService" class="org.egovframe.rte.fdl.idgnr.impl.EgovTableIdGnrServiceImpl" destroy-method="destroy">
        <property name="dataSource" ref="egov.dataSource" />
        <property name="strategy"   ref="assetShortageRunIdStrategy" />
        <property name="blockSize"  value="10"/>
        <property name="table"      value="COMTECOPSEQ"/>
        <property name="tableName"  value="ASSET_SHORT_RUN_ID"/>
    </bean>
    <bean name="assetShortageRunIdStrategy" class="org.egovframe.rte.fdl.idgnr.impl.strategy.EgovIdGnrStrategyImpl">
        <property name="prefix"   value="SHRT_" />
        <property name="cipers"   value="15" />
        <property name="fillChar" value="0" />
    </bean>

</beans>
